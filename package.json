{
  "name": "demonx-circuit-preview",
  "version": "0.4.1",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "DemonX Circuit desktop preview",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p desktop/tsconfig.json",
    "postinstall": "node node_modules/electron/install.js",
    "start": "npm run build && npm run postinstall && electron .",
    "capture": "npm run build && npm run postinstall && electron . --capture-screenshot"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "typescript": "5.9.3"
  }
}
