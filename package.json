{
  "name": "demonx-circuit-preview",
  "version": "0.5.0",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "DemonX Circuit desktop preview",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p desktop/tsconfig.json && esbuild desktop/renderer.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=desktop/dist/renderer.js",
    "test:schematic-model": "npm run build && node prototype/schematic-model-smoke.mjs",
    "test:native-roundtrip": "npm run build && node prototype/native-roundtrip-smoke.mjs",
    "test:mcp": "npm run build && node prototype/mcp-sdk-smoke.mjs",
    "test:owner-schematic-cli-args": "node prototype/owner-schematic-cli-args-smoke.mjs",
    "verify:owner-schematic": "npm run build && node prototype/verify-owner-schematic.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "start": "npm run build && npm run postinstall && electron .",
    "dev:windows": "powershell.exe -NoProfile -File scripts/Start-DemonXCircuitDev.ps1 -Watch",
    "capture": "npm run build && npm run postinstall && electron . --capture-screenshot"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "konva": "10.9.0",
    "zod": "4.6.7"
  }
}
